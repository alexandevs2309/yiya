# =============================================================================
# D'Yiya POS — Dockerfile para Railway (single service)
# =============================================================================
# Stage 1: Build frontend
FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npx vite build

# Stage 2: Backend (Django + Daphne)
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcups2-dev \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ .
COPY --from=frontend /build/dist /app/frontend_dist

RUN mkdir -p /app/static /app/media /app/certs && \
    python manage.py collectstatic --noinput

EXPOSE 8080

CMD python manage.py migrate --noinput && \
    exec daphne -b 0.0.0.0 -p ${PORT:-8080} config.asgi:application