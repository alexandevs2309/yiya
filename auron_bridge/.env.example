# ─── Modo LOCAL ───
# Descomenta para desarrollo local con Docker
BRIDGE_API_URL=http://localhost:8000/api

# ─── Modo PRODUCCIÓN (Railway) ───
# Descomenta estas líneas y comenta la de arriba para Railway:
# BRIDGE_API_URL=https://yiyapremiun-production.up.railway.app/api

BRIDGE_TOKEN=auron-bridge-dev-token
BRIDGE_POLL_INTERVAL=2
BRIDGE_LOG_LEVEL=INFO

# Printer (auto-detect USB)
PRINTER_CONNECTION_TYPE=auto
# PRINTER_CONNECTION_TYPE=usb  # USB manual (descomentar y poner IDs)
# PRINTER_USB_VENDOR_ID=0x0fe6
# PRINTER_USB_PRODUCT_ID=0x811e
# PRINTER_USB_OUT_EP=0x02
# PRINTER_USB_IN_EP=0x82
# PRINTER_CONNECTION_TYPE=network  # Red (descomentar para IP)
# PRINTER_NETWORK_IP=192.168.1.100
# PRINTER_NETWORK_PORT=9100
PAPER_WIDTH=48
